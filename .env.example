# Copy to .env locally; never commit real credentials.
BOT_TOKEN=
# Leave DATABASE_URL unset to use local PGlite.
# DATABASE_URL=postgres://r9k:password@localhost:5432/r9k
PGLITE_DIR=.data/pglite
LOG_LEVEL=info
# Required only for Compose; use a strong URL-safe password.
# POSTGRES_PASSWORD=

# Optional HTTP health server (unset disables it; Compose sets 8080 internally)
# HEALTH_PORT=8080
# Optional numeric destination for sanitized error alerts
# ALERT_CHAT_ID=123456789
PRIVACY_URL=https://github.com/NocturnalAviator/R9K/blob/main/docs/PRIVACY.md
# Backup scripts read exported variables, not this file automatically:
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_DIR=/srv/backups/r9k
# BACKUP_AGE_IDENTITY=/secure/path/age-key.txt
